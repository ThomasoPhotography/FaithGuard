# ----------------------------------------------------------------------
# FaithGuard .htaccess Configuration
# ----------------------------------------------------------------------
# Turn on URL Rewriting
RewriteEngine On

# 1. Force HTTPS
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP:X-Forwarded-Proto} !https
RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

# 2. Security: Disable Directory Browsing
# Prevents visitors from seeing a list of your files if no index.php exists
Options -Indexes

# 3. Security: Block Sensitive File Extensions
# Blocks access to .git, .env, .sql dumps, logs, and ini files
<FilesMatch "^\.|^\.env|\.sql$|\.log$|\.ini$">
    Require all denied
</FilesMatch>

# 3b. Security: Protect PHP Session Cookies from XSS and CSRF
<IfModule mod_php.c>
    php_value session.cookie_httponly 1
    php_value session.cookie_secure 1
    php_value session.cookie_samesite "Strict"
</IfModule>

# 3c. Security: Harden HTTP Headers
<IfModule mod_headers.c>
    # Enforce HTTPS strictly for 1 year (HSTS)
    Header set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
    
    # Prevent clickjacking attacks by forbidding your site to be framed
    Header set X-Frame-Options "DENY"
    
    # Prevent browsers from trying to guess asset mime-types (blocks XSS)
    Header set X-Content-Type-Options "nosniff"
</IfModule>

# 4. Security: Protect Internal Directories
# Prevents direct HTTP access to your database connection logic
# Your PHP files can still include them, but users cannot visit them in the browser
# Updated to be case-insensitive [NC] and match with or without trailing slash
RewriteRule ^db(/.*)?$ - [F,L,NC]
# RewriteRule ^api/helper/ - [F,L]

# 5. Custom Error Pages (Optional)
# ErrorDocument 404 /index.php
# ErrorDocument 500 /index.php

# 6. Performance: Enable Gzip Compression (Speed up loading)
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/plain
    AddOutputFilterByType DEFLATE text/html
    AddOutputFilterByType DEFLATE text/xml
    AddOutputFilterByType DEFLATE text/css
    AddOutputFilterByType DEFLATE application/xml
    AddOutputFilterByType DEFLATE application/xhtml+xml
    AddOutputFilterByType DEFLATE application/rss+xml
    AddOutputFilterByType DEFLATE application/javascript
    AddOutputFilterByType DEFLATE application/x-javascript
</IfModule>